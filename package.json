{
  "name": "@titanwings/distilly",
  "version": "1.0.0",
  "description": "Distill source material into reusable Person Profiles for AI agents.",
  "type": "module",
  "bin": {
    "distilly": "bin/distilly.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "assets/",
    "scripts/",
    "SKILL.md",
    "prompts/",
    "references/",
